SERVER_HOST=
SERVER_PORT=22
SERVER_USER=root
SERVER_PASSWORD=
PAPERCLIP_DOMAIN=
# Owner API client: explicit origin, without trailing slash/path/credentials.
# LAN deployment uses http://loginom-swarm.bg.local (port 80).
# If omitted, paperclip-api.py uses https:// + PAPERCLIP_DOMAIN.
# This controls the client only; configure the same public/auth URL on the server.
# PAPERCLIP_BASE_URL=http://loginom-swarm.bg.local
PAPERCLIP_EMAIL=
PAPERCLIP_PASSWORD=
LOGINOM_API_KEY=
