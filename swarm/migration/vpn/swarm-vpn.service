[Unit]
Description=Loginom Swarm mandatory VPN
Requires=swarm-vpn-firewall.service
After=network-online.target swarm-vpn-firewall.service docker.service
Wants=network-online.target
Before=loginom-swarm-worker.service loginom-swarm-memory.service

[Service]
User=swarm-vpn
Group=swarm-vpn
ExecStartPre=/usr/bin/test -d /sys/class/net/br-swarm
ExecStart=/usr/local/libexec/swarm-vpn/sing-box run -c /etc/loginom-swarm-vpn/config.json
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
